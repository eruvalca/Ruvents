@inherits Ruvents.UI.Components.CancellableComponentBase

@using Cropper.Blazor.Components
@using Cropper.Blazor.Models

<div class="photo-crop">
    <div class="form-field">
        <label for="crop-photo">Profile photo</label>
        @* The picker is prerendered before the circuit connects; a selection made
           then is silently dropped, so keep it disabled until it can respond. *@
        <InputFile id="crop-photo" accept="image/jpeg,image/png,image/webp" OnChange="OnFileSelectedAsync" disabled="@(!RendererInfo.IsInteractive)" />
        <p>JPEG, PNG, or WebP, up to 2 MB. Drag and zoom to position your face, then choose <strong>Use this crop</strong>.</p>
    </div>

    @if (_source is not null)
    {
        <div class="cropper-shell">
            <CropperComponent @ref="_cropper" Src="@_source" Options="@_options" Class="cropper" />
        </div>
        <button type="button" @onclick="CaptureAsync">Use this crop</button>
    }

    @if (_preview is not null)
    {
        <p class="photo-crop-preview">
            <img class="avatar-preview" src="@_preview" alt="Your cropped profile photo" width="96" height="96" />
        </p>
        @* The preview state lives in this interactive component, and a static
           parent cannot observe it across the render-mode boundary. Rendering the
           submit button here keeps it absent until there is a crop to save. *@
        <button type="submit">Save photo</button>
    }

    <input type="hidden" name="PhotoData" value="@_preview" />

    @if (_error is not null)
    {
        <p class="error-text" role="alert">@_error</p>
    }
</div>
