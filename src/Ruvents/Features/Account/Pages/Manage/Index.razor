@page "/Account/Manage"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Ruvents.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Profile</PageTitle>

<h3>Profile</h3>
<StatusMessage />

@if (_user is not null)
{
    <div class="account-photo">
        <img class="avatar-preview" src="@PhotoUrl" alt="Your profile photo" width="96" height="96" />
        <p>
            <a href="Account/Manage/Photo">Change your profile photo</a>
        </p>
    </div>
}

<EditForm class="account-form" Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post">
    <DataAnnotationsValidator />
    <ValidationSummary class="error-text" role="alert" />

    <fieldset>
        <legend>Your name</legend>
        <div class="form-field">
            <label for="Input.FirstName">First name</label>
            <InputText @bind-Value="Input.FirstName" id="Input.FirstName" autocomplete="given-name" aria-required="true" />
            <ValidationMessage For="() => Input.FirstName" class="error-text" />
        </div>
        <div class="form-field">
            <label for="Input.MiddleName">Middle name <span class="optional">(optional)</span></label>
            <InputText @bind-Value="Input.MiddleName" id="Input.MiddleName" autocomplete="additional-name" />
            <ValidationMessage For="() => Input.MiddleName" class="error-text" />
        </div>
        <div class="form-field">
            <label for="Input.LastName">Last name</label>
            <InputText @bind-Value="Input.LastName" id="Input.LastName" autocomplete="family-name" aria-required="true" />
            <ValidationMessage For="() => Input.LastName" class="error-text" />
        </div>
        <div class="form-field">
            <label for="Input.DisplayName">Display name <span class="optional">(optional)</span></label>
            <InputText @bind-Value="Input.DisplayName" id="Input.DisplayName" autocomplete="nickname" placeholder="Defaults to your full name" />
            <p>This is the name others see on comments, RSVPs, and member lists.</p>
            <ValidationMessage For="() => Input.DisplayName" class="error-text" />
        </div>
    </fieldset>

    <fieldset>
        <legend>Account details</legend>
        <div class="form-field">
            <label for="username">Email</label>
            <input type="text" value="@_username" id="username" disabled />
            <p>Change your email from <a href="Account/Manage/Email">Email settings</a>.</p>
        </div>
        <div class="form-field">
            <label for="Input.PhoneNumber">Phone number <span class="optional">(optional)</span></label>
            <InputText @bind-Value="Input.PhoneNumber" id="Input.PhoneNumber" autocomplete="tel" placeholder="Enter your phone number" />
            <ValidationMessage For="() => Input.PhoneNumber" class="error-text" />
        </div>
    </fieldset>

    <button type="submit">Save changes</button>
</EditForm>
