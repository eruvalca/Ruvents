@inherits LayoutComponentBase

<a class="skip-link" href="#main-content" data-enhance-nav="false">Skip to content</a>

<div class="page">
    <FluentLayout Id="app-layout" Class="app-layout" GlobalScrollbar="true" Height="auto">
        <FluentLayoutItem Area="LayoutArea.Header">
            <header class="site-header">
                <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="var(--spacingHorizontalM)" Height="100%">
                    <div class="menu-toggle">
                        <FluentLayoutHamburger Id="site-menu" PanelHeader="Ruvents" />
                    </div>
                    <a class="site-name" href="/">Ruvents</a>
                </FluentStack>
            </header>
        </FluentLayoutItem>
        <FluentLayoutItem Area="LayoutArea.Navigation" Class="site-navigation">
            <NavMenu />
        </FluentLayoutItem>
        <FluentLayoutItem Area="LayoutArea.Content">
            <main id="main-content" class="content-container" tabindex="-1">
                @Body
            </main>
        </FluentLayoutItem>
        <FluentLayoutItem Area="LayoutArea.Footer">
            <footer class="site-footer">Ruvents</footer>
        </FluentLayoutItem>
    </FluentLayout>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <FluentStack Class="error-content" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="var(--spacingHorizontalL)" Wrap="true">
        <span>An unhandled error has occurred.</span>
        <a href="." class="reload">Reload</a>
        <button type="button" class="dismiss">Dismiss</button>
    </FluentStack>
</div>
