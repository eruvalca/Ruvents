@inherits LayoutComponentBase

<a class="skip-link" href="#main-content" data-enhance-nav="false">Skip to content</a>

<div class="page">
    <header class="site-header">
        <div class="site-header-inner">
            <a class="site-name" href="/">
                <span class="site-mark" aria-hidden="true"></span>
                <span class="site-wordmark">Ruvents</span>
            </a>
            <p class="site-tagline">Family moments, organized</p>
            <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch colour theme">
                <span data-theme-toggle-label>Auto</span>
            </button>
        </div>
    </header>

    <div class="page-body">
        <div class="site-navigation">
            <NavMenu />
        </div>
        <main id="main-content" class="content-container" tabindex="-1">
            @Body
        </main>
        <footer class="site-footer">
            <PwaUpdateNotice />
            <PwaControls />
            <span>Ruvents — made for the people you gather with.</span>
        </footer>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <span>An unhandled error has occurred.</span>
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss">Dismiss</button>
</div>
