@implements IDisposable

@inject NavigationManager NavigationManager

<div class="navigation-content">
    @* Static SSR does not run FluentNav's roving-tabindex initialization. Keep
       native links keyboard reachable, including before Blazor starts. *@
    <FluentNav UseIcons="false" aria-label="Main navigation">
        <FluentNavItem Href="/" Match="NavLinkMatch.All" tabindex="0">Home</FluentNavItem>
        <FluentNavItem Href="counter" tabindex="0">Counter</FluentNavItem>
        <FluentNavItem Href="auth" tabindex="0">Auth Required</FluentNavItem>
        <FluentNavSectionHeader Title="Account" />
        <AuthorizeView>
            <Authorized>
                <FluentNavItem Href="Account/Manage" tabindex="0">@context.User.Identity?.Name</FluentNavItem>
            </Authorized>
            <NotAuthorized>
                <FluentNavItem Href="Account/Register" tabindex="0">Register</FluentNavItem>
                <FluentNavItem Href="Account/Login" tabindex="0">Login</FluentNavItem>
            </NotAuthorized>
        </AuthorizeView>
    </FluentNav>
    <AuthorizeView>
        <Authorized>
            <form class="logout-form" action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@_currentUrl" />
                <button type="submit">Logout</button>
            </form>
        </Authorized>
    </AuthorizeView>
</div>
