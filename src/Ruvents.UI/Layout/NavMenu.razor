@implements IDisposable

@inject NavigationManager NavigationManager

<div class="site-navigation">
    <a class="site-name" href="">Ruvents</a>

    <nav aria-label="Main navigation">
        <ul class="navigation-links">
            <li><NavLink href="" Match="NavLinkMatch.All">Home</NavLink></li>
            <li><NavLink href="counter">Counter</NavLink></li>
            <li><NavLink href="auth">Auth Required</NavLink></li>

            <AuthorizeView>
                <Authorized>
                    <li><NavLink href="Account/Manage">@context.User.Identity?.Name</NavLink></li>
                    <li>
                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@_currentUrl" />
                            <button type="submit">Logout</button>
                        </form>
                    </li>
                </Authorized>
                <NotAuthorized>
                    <li><NavLink href="Account/Register">Register</NavLink></li>
                    <li><NavLink href="Account/Login">Login</NavLink></li>
                </NotAuthorized>
            </AuthorizeView>
        </ul>
    </nav>
</div>
